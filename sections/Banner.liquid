<style>
  .banner-section {
    width: 1440px;
    max-width: 100%;
    height: 700px;
    background-image: url("{{ 'Background.png' | asset_url }}");
    background-size: cover;
    background-position: center;
    margin: 0 auto;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    overflow: hidden;
  }
  .banner-left {
    width: 40%;
    padding-left: 100px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }
  .banner-title {
    font-family: serif;
    font-size: 75px;
    font-weight: 700;
    line-height: 1.1;
    color: #000000;
    margin: 0 0 20px 0;
  }
  .banner-desc {
    font-family: sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333333;
    max-width: 400px;
    margin: 0 0 40px 0;
  }
  .banner-btn {
    font-family: sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #000000;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
  }
  .banner-right {
    width: 60%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding-left: 33px; 
    padding-bottom: 8px; 
    box-sizing: border-box;
  }
  .banner-products-img {
    width: 878px;
    height: 585px;
    object-fit: contain;
  }
  @media (max-width: 1440px) {
    .banner-section {
      width: 440px;
      height: 618px;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      padding: 40px 20px 0 20px;
      text-align: center;
    }
    .banner-left {
      width: 100%;
      padding-left: 0;
      align-items: center;
    }
    .banner-title {
      font-size: 36px;
      margin-bottom: 15px;
    }
    .banner-desc {
      font-size: 14px;
      margin-bottom: 25px;
      max-width: 100%;
    }
    .banner-right {
      width: 100%;
      height: 275px;
      padding-left: 0;
      padding-bottom: 0;
      justify-content: center;
      margin-top: auto;
    }
    .banner-products-img {
      width: 413px;
      height: 275px;
    }
  }
</style>
<div class="banner-section">
  <div class="banner-left">
    <h1 class="banner-title">The Science<br>of Radiance</h1>
    <p class="banner-desc">Discover curated formulas that transform your daily routine into a luminous ritual.</p>
    <a href="#" class="banner-btn">Explore Collection →</a>
  </div>
  <div class="banner-right">
    <img src="{{ 'Products.png' | asset_url }}" class="banner-products-img" alt="Cosmetic Products">
  </div>
</div>
{% schema %}
{
  "name": "Homepage Banner",
  "settings": [],
  "presets": [
    {
      "name": "Homepage Banner"
    }
  ]
}
{% endschema %}