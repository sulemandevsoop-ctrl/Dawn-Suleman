<style>
  .marquee-container {
    width: 1448px;
    max-width: 100%;
    height: 35px;
    background-color: #000000;
    display: flex;
    align-items: center;
    margin: 0 auto;
    overflow: hidden;
  }
  marquee {
    width: 100%;
  }
  marquee span {
    color: #ffffff;
    font-family: sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-right: 50px;
  }
  marquee .dot {
    font-size: 14px;
    margin-right: 50px;
  }
  @media (max-width: 768px) {
    .marquee-container {
      width: 440px;
      height: 39px;
      padding: 13px 50px;
      box-sizing: border-box;
    } 
    marquee span, marquee .dot {
      margin-right: 10px;
    }
  }
</style>
<div class="marquee-container">
  <marquee scrollamount="5" behavior="scroll" direction="left">
    <span>FREE SHIPPING ON ORDERS OVER $59</span>
    <span class="dot">•</span>
    <span>EARN REWARDS WITH EVERY PURCHASE</span>
    <span class="dot">•</span>
    <span>OVER 10,000 BEAUTY PRODUCTS</span>
    <span class="dot">•</span>
    <span>AUTHENTIC BRANDS ONLY</span>
  </marquee>
</div>
{% schema %}
{
  "name": "Marquee Bar",
  "settings": [],
  "presets": [
    {
      "name": "Marquee Bar"
    }
  ]
}
{% endschema %}